# Game dumps, keys and anything extracted from them. These belong to their owners and never go in git.
*.xci
*.nsp
*.[dD][xX][cC][iI]
*.[dD][nN][sS][pP]
*.nsz
*.xcz
*.nca
*.nro
*.nso
*.npdm
*.keys
*.tik
*.cert
exefs/
romfs/
/work/
/keys/
/dumps/

# Made from the game's files: shader corpora (SNX_SHADER_CORPUS), SPIR-V dumps, screenshots
*.snxs
*.spv
*.ppm
vkshader_*.glsl

# Recompiled games: runtime, game module, generated C, data, saves, settings and logs
/games/

# Build output, and the AppImage scripts/make-appimage.sh makes
/build*/
__pycache__/
*.o
*.so
/AppDir/
/dist/*.AppImage
/dist/*.zsync
/dist/appinfo

# The Windows toolchains and prebuilt binaries bundled in the MZ Labs zip, in case one is unpacked over the checkout
# (scripts/import-upstream.sh leaves them out of the upstream branch)
/python/
/tcc/
/gcc/
/w64devkit/
/bin/
*.exe

# Gradle's state and the SDK's path when dist/android is built in place (its output goes to the stage folder)
/dist/android/.gradle/
/dist/android/local.properties

# Third-party packages downloaded by CPM.cmake (cmake/dependencies.cmake), and the Windows toolchain from
# scripts/bootstrap.ps1
/.cache/
/deps/

# Claude Code state local to this checkout
.claude/audit-state.json
.claude/settings.local.json
.claude/worktrees/
