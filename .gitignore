# Game dumps, keys and anything extracted from them. These belong to their owners and never go in git.
*.xci
*.nsp
*.nsz
*.xcz
*.nca
*.nro
*.keys
*.tik
*.cert
/work/
/keys/
/dumps/

# Recompiled games: runtime, game module, generated C, data, saves, settings and logs
/games/

# Build output
/build*/
__pycache__/
*.o
*.so

# The Windows toolchains and prebuilt binaries bundled in the MZ Labs zip (see scripts/import-upstream.sh)
/python/
/gcc/
/w64devkit/
/bin/
*.exe

# Third-party packages downloaded by CPM.cmake (cmake/dependencies.cmake), and the Windows toolchain from
# scripts/bootstrap.ps1
/.cache/
/deps/

# Claude Code state local to this checkout
.claude/audit-state.json
.claude/settings.local.json
.claude/worktrees/
